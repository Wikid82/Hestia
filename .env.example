# Path to the SQLite database file (auto-created on first run).
DB_PATH=./data/hestia.db

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# IANA timezone the container runs in (e.g. America/New_York, Europe/London).
# Chore due-dates and "due today" are computed from the container's local
# clock, so this should match your household, not wherever the server
# physically lives. Defaults to UTC if unset.
TZ=

# --- Outbound email (optional) ---
# All of this is optional and only needed for features that send email
# (e.g. the invite system). Leave everything below unset to run without
# outbound email entirely. If you set any of SMTP_HOST/SMTP_PORT/SMTP_FROM,
# you must set all three (SMTP_USERNAME/SMTP_PASSWORD are only required if
# your relay needs auth) and BASE_URL, or the server will refuse to start —
# better to fail fast at boot than silently never send an email.
#
# Deliberately env-var-only, not settable from the web UI: SMTP creds are
# a credential to an external system, and storing them reversibly in the
# same sqlite file this app tells you to "just copy to back up" would be a
# meaningfully worse security posture than the AUTH_SECRET-style pattern
# already used here. See docs/current_spec.md for the full rationale.

# The externally-reachable URL of this instance, used to build links (e.g.
# invite-accept links) in outbound email. e.g. https://hestia.example.com
BASE_URL=

SMTP_HOST=
SMTP_PORT=
# Optional — only needed if your SMTP relay requires authentication.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true (default) = connect via implicit TLS, the common pattern on port
# 465. Set to false for a plaintext connection that opportunistically
# upgrades via STARTTLS if the server offers it — the common pattern on
# port 587/25.
SMTP_USE_TLS=true

# --- Signup (optional) ---
# false (default): only the very first signup on a fresh instance is
# allowed (that's how you bootstrap it) — everyone after that needs an
# invite (see the admin/household invite screens). There are no real
# users of this app yet, so closed-by-default is the safer starting
# point: nobody should be able to spin up a household on someone else's
# found instance without being asked. Set to true to allow open signup
# for every household after the first; if you do, the security
# implications of that are yours to own as the instance operator.
ALLOW_PUBLIC_SIGNUP=false
