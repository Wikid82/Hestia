# Path to the SQLite database file (auto-created on first run).
DATABASE_PATH=./data/hestia.db

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# IANA timezone the container runs in (e.g. America/New_York, Europe/London).
# Chore due-dates and "due today" are computed from the container's local
# clock, so this should match your household, not wherever the server
# physically lives. Defaults to UTC if unset.
TZ=
