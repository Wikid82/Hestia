# Hestia environment variables. Copy this file to .env and uncomment what
# you need. Full reference (defaults, every option, what each one does):
# docs/environment.md
#
# Only AUTH_SECRET is required — everything else is optional and the app
# runs fine with it left commented out.

# Required. Generate with: openssl rand -base64 32
#AUTH_SECRET=

# Default: UTC. Set to your household's IANA timezone, e.g. America/New_York.
#TZ=

# --- Outbound email (optional — enables the invite system) ---
# All optional; leave commented out to run without outbound email. If you
# set any SMTP_* variable below, see docs/environment.md — several of them
# become required together.
#BASE_URL=
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_USE_TLS=true

# --- Signup (optional) ---
# Default: false — closed after the first signup. See docs/environment.md.
#ALLOW_PUBLIC_SIGNUP=false

# DB_PATH, PORT, STATIC_DIR, GIN_MODE aren't listed here — the Docker image
# sets them itself, and docker-compose.yml doesn't pass them through. See
# docs/environment.md if you're running the backend directly instead of
# via Docker.
