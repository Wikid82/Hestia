# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root has no package.json anymore — frontend/.gitignore and
# backend/.gitignore cover their own node_modules/build artifacts)

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite database
/data/*.db
/data/*.db-*

# personal local compose overrides (paths specific to your machine) —
# copy docker-compose.override.yml.example to get started
docker-compose.override.yml

# local Claude Code permissions (personal, not shared)
.claude/settings.local.json

# Claude Code worktree scratch space (full repo copies, incl. node_modules)
.claude/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
.private/**

# Playwright e2e — auth storage state, run artifacts
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
