# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite database
/data/*.db
/data/*.db-*

# personal local compose overrides (paths specific to your machine) —
# copy docker-compose.override.yml.example to get started
docker-compose.override.yml

# local Claude Code permissions (personal, not shared)
.claude/settings.local.json

# Claude Code worktree scratch space (full repo copies, incl. node_modules)
.claude/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
