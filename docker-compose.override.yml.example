# Personal local overrides — not used by anyone but you.
#
# `docker compose up` automatically merges this file on top of
# docker-compose.yml if it exists, no extra flags needed. Copy it once:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# then edit freely — docker-compose.override.yml is gitignored.
#
# The base docker-compose.yml already bind-mounts ./data (repo-relative) so
# it works out of the box for anyone cloning the repo. This override exists
# for swapping in a persistent host path outside the repo instead — e.g. if
# you keep all your self-hosted app data under one directory tree and don't
# want it tied to wherever you happen to have this repo checked out.

services:
  hestia:
    volumes:
      - /srv/appdata/hestia:/data
    # Real SMTP credentials and your instance's real public URL are exactly
    # the kind of personal, don't-commit values this override file is for —
    # putting them here instead of docker-compose.yml keeps them out of git
    # even if you fork/commit changes to the base file. All optional; see
    # docs/environment.md for what each one does. Uncomment and fill in to
    # enable the invite system's outbound email.
    # environment:
    #   BASE_URL: https://hestia.example.com
    #   SMTP_SERVER: smtp.example.com
    #   SMTP_PORT: "587"
    #   SMTP_USERNAME: hestia@example.com
    #   SMTP_PASSWORD: changeme
    #   SMTP_FROM: hestia@example.com
    #   SMTP_USE_TLS: "false"
    #   # Only if you want every signup after the first to stay open —
    #   # closed by default, see docs/environment.md.
    #   ALLOW_PUBLIC_SIGNUP: "false"
